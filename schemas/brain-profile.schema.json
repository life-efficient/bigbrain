{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://bigbrain.local/schemas/brain-profile.schema.json",
  "title": "BigBrain routing description",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "identity"],
  "properties": {
    "schema_version": { "const": 1 },
    "identity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["brain_id", "brain_name", "description"],
      "properties": {
        "brain_id": { "type": "string", "minLength": 1 },
        "brain_name": { "type": "string", "minLength": 1 },
        "description": { "type": "string", "minLength": 1 }
      }
    }
  }
}
